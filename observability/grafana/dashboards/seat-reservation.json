      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "show_id": "show",
              "Value #A": "total",
              "Value #B": "available",
              "Value #C": "held",
              "Value #D": "confirmed",
              "Value #E": "drift"
            },
            "indexByName": {
              "show_id": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            }
          }
        }
      ]
