PORT=8080
DATABASE_URL=postgres://seats:seats@localhost:5433/seats
REDIS_URL=redis://localhost:6380
# REDIS_ENABLED=true     # set false to run on Postgres alone
# SEAT_CACHE_TTL_SECONDS=30
# SEAT_HOLD_SECONDS=300   # TTL of a seat hold in Redis
JWT_SECRET=dev-jwt-secret-change-me
ADMIN_TOKEN=dev-admin-token
# Used by the curl examples and `make burst`, not by the server: the address of the app you are talking to.
BASE=http://localhost:8080
# LOGS_TOKEN=            # if set, GET /logs requires "Authorization: Bearer <token>"
# LOKI_URL=              # push logs to Loki (used on Render), for example https://<monitoring host>/loki/api/v1/push
# LOKI_TOKEN=            # bearer token the Loki endpoint expects
# METRICS_MAX_SHOWS=0        # per-show seat gauges: 0 = every show, or only the N newest
# LOG_BUFFER_LINES=50000   # recent log lines kept in memory for GET /logs (about 300 bytes each)
# METRICS_CACHE_SECONDS=10    # how long the seat gauges and /stats reuse one database read
# SHOW_STATE_CACHE_MS=0      # GET /shows/:id reuses one database read for this long (0 = off); same-instance reserve/cancel clears it
# PG_POOL_MAX=40
