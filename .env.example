PORT=8080
DATABASE_URL=postgres://seats:seats@localhost:5433/seats
REDIS_URL=redis://localhost:6380
# REDIS_ENABLED=true     # set false to run on Postgres alone
# SEAT_CACHE_TTL_SECONDS=30
# SEAT_HOLD_SECONDS=300   # TTL of a seat hold in Redis
JWT_SECRET=dev-jwt-secret-change-me
ADMIN_TOKEN=dev-admin-token
# LOGS_TOKEN=            # if set, GET /logs requires "Authorization: Bearer <token>"
# NEW_RELIC_LICENSE_KEY=     # ingest license key; when set, logs are also sent to New Relic
# NEW_RELIC_REGION=us        # us (default) or eu; or set NEW_RELIC_LOG_ENDPOINT
# NEW_RELIC_APP_NAME=seat-reservation
# NEW_RELIC_METRICS_ENABLED=true          # also send metrics (needs the license key)
# NEW_RELIC_METRICS_INTERVAL_SECONDS=15
# METRICS_MAX_SHOWS=0        # per-show seat gauges: 0 = every show, or only the N newest
# LOG_BUFFER_LINES=50000   # recent log lines kept in memory for GET /logs (about 300 bytes each)
# PG_POOL_MAX=20
